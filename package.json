{
  "name": "llm-spec",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=esm --sourcemap --packages=external",
    "build:watch": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=esm --sourcemap --watch --packages=external",
    "build:scripts": "esbuild scripts/*.ts --bundle --platform=node --target=node20 --outdir=dist/scripts --format=esm --sourcemap --out-extension:.js=.mjs",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "node --watch dist/index.js",
    "test:sdk": "node dist/index.js",
    "fetch-docs": "node dist/scripts/fetch-docs.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "LLM specification testing and validation tool",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@anthropic-ai/sdk": "^0.90.0",
    "@google/genai": "^1.47.0",
    "@openai/codex-sdk": "^0.117.0",
    "openai": "^6.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2",
    "undici": "^7.22.0"
  }
}

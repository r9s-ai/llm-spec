{
  endpoint: "/v1/chat/completions",
  schemas: {
    response: "openai.ChatCompletionResponse",
    stream_chunk: "openai.ChatCompletionChunkResponse",
  },
  stream_expectations: {
    // OpenAI chat.completions streaming ends with "data: [DONE]" (parser maps it to "[DONE]").
    min_observations: 2,
    checks: [
      {
        type: "required_terminal",
        value: "[DONE]",
      },
    ],
  },
  tests: [
    {
      name: "baseline",
      description: "Baseline test: only required parameters",
      params: {
        messages: [
          {
            role: "user",
            content: "Say hello",
          },
        ],
      },
      baseline: true,
      tags: ["baseline"],
      required_fields: ["choices[0].message"],
    },
    {
      name: "input_text_image",
      description: "Test input with text + image (data URI)",
      variants: {
        image_data_uri: [
          {
            variant_id: "png",
            format: "png",
            image_url: "$asset_data_uri(assets/images/test_base.png,image/png)",
          },
          {
            variant_id: "jpeg",
            format: "jpeg",
            image_url: "$asset_data_uri(assets/images/test_base.jpeg,image/jpeg)",
          },
          {
            variant_id: "jpg",
            format: "jpg",
            image_url: "$asset_data_uri(assets/images/test_base.jpg,image/jpeg)",
          },
          {
            variant_id: "webp",
            format: "webp",
            image_url: "$asset_data_uri(assets/images/test_base.webp,image/webp)",
          },
          {
            variant_id: "gif",
            format: "gif",
            image_url: "$asset_data_uri(assets/images/test_base.gif,image/gif)",
          },
        ],
      },
      params: {
        messages: [
          {
            role: "user",
            content: [
              {
                type: "text",
                text: "Describe this image in one sentence.",
              },
              {
                type: "image_url",
                image_url: {
                  url: "$image_data_uri.image_url",
                },
              },
            ],
          },
        ],
      },
      cover_params: [
        {
          name: "messages[0].content.image.format",
          value: "$image_data_uri.format",
        },
      ],
      required_fields: ["choices[0].message.content"],
      tags: ["parameter", "multimodal"],
    },
    {
      name: "temperature",
      description: "Test temperature parameter",
      params: {
        temperature: 0.7,
      },
      cover_params: [
        {
          name: "temperature",
          value: 0.7,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "max_tokens",
      description: "Test max_tokens parameter",
      params: {
        max_tokens: 100,
      },
      cover_params: [
        {
          name: "max_tokens",
          value: 100,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "top_p",
      description: "Test top_p parameter",
      params: {
        top_p: 0.9,
      },
      cover_params: [
        {
          name: "top_p",
          value: 0.9,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "n",
      description: "Test n parameter (generate multiple responses)",
      params: {
        n: 2,
      },
      cover_params: [
        {
          name: "n",
          value: 2,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "stop",
      description: "Test stop parameter variants",
      variants: {
        stop_variant: [
          {
            variant_id: "string",
            value: "\n",
          },
          {
            variant_id: "array",
            value: [
              "\n",
              "END",
            ],
          },
        ],
      },
      params: {
        stop: "$stop_variant.value",
      },
      cover_params: [
        {
          name: "stop",
          value: "$stop_variant.value",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "frequency_penalty",
      description: "Test frequency_penalty parameter",
      params: {
        frequency_penalty: 0.5,
      },
      cover_params: [
        {
          name: "frequency_penalty",
          value: 0.5,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "presence_penalty",
      description: "Test presence_penalty parameter",
      params: {
        presence_penalty: 0.5,
      },
      cover_params: [
        {
          name: "presence_penalty",
          value: 0.5,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "seed",
      description: "Test seed parameter (deterministic output)",
      params: {
        seed: 12345,
      },
      cover_params: [
        {
          name: "seed",
          value: 12345,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "max_completion_tokens",
      description: "Test max_completion_tokens parameter (new parameter)",
      params: {
        max_completion_tokens: 100,
      },
      cover_params: [
        {
          name: "max_completion_tokens",
          value: 100,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "user",
      description: "Test user parameter (user identifier)",
      params: {
        user: "user-123",
      },
      cover_params: [
        {
          name: "user",
          value: "user-123",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "metadata",
      description: "Test metadata parameter",
      params: {
        metadata: {
          request_id: "chat-meta-123",
          scenario: "parameter-test",
        },
      },
      cover_params: [
        {
          name: "metadata",
          value: {
            request_id: "chat-meta-123",
            scenario: "parameter-test",
          },
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "response_format.type",
      description: "Test response_format.type variants",
      variants: {
        format_variant: [
          {
            variant_id: "text",
            messages: [
              {
                role: "user",
                content: "Say hello",
              },
            ],
            response_format: {
              type: "text",
            },
            value: "text",
          },
          {
            variant_id: "json_object",
            messages: [
              {
                role: "user",
                content: "Return JSON: {\"status\": \"ok\"}",
              },
            ],
            response_format: {
              type: "json_object",
            },
            value: "json_object",
          },
          {
            variant_id: "json_schema",
            messages: [
              {
                role: "user",
                content: "Generate a person's info",
              },
            ],
            response_format: {
              type: "json_schema",
              json_schema: {
                name: "person",
                schema: {
                  type: "object",
                  properties: {
                    name: {
                      type: "string",
                    },
                    age: {
                      type: "number",
                    },
                  },
                  required: [
                    "name",
                    "age",
                  ],
                },
              },
            },
            value: "json_schema",
          },
        ],
      },
      params: {
        messages: "$format_variant.messages",
        response_format: "$format_variant.response_format",
      },
      cover_params: [
        {
          name: "response_format.type",
          value: "$format_variant.value",
        },
      ],
      required_fields: ["choices[0].message.content"],
      tags: ["parameter", "structured-output"],
    },
    {
      name: "tools",
      description: "Test tools parameter (function calling)",
      params: {
        messages: [
          {
            role: "user",
            content: "What's the weather in Beijing?",
          },
        ],
        tools: [
          {
            type: "function",
            "function": {
              name: "get_weather",
              description: "Get current weather",
              parameters: {
                type: "object",
                properties: {
                  location: {
                    type: "string",
                    description: "City name",
                  },
                },
                required: [
                  "location",
                ],
              },
            },
          },
        ],
      },
      cover_params: [
        {
          name: "tools",
          value: [
            {
              type: "function",
            },
          ],
        },
      ],
      required_fields: ["choices[0].message.tool_calls"],
      tags: ["parameter", "tooling"],
    },
    {
      name: "tool_choice",
      description: "Test different tool_choice values",
      variants: {
        tool_choice: [
          "none",
          "auto",
          "required",
        ],
      },
      params: {
        messages: [
          {
            role: "user",
            content: "What's the weather?",
          },
        ],
        tools: [
          {
            type: "function",
            "function": {
              name: "get_weather",
              description: "Get weather",
              parameters: {
                type: "object",
                properties: {
                  location: {
                    type: "string",
                  },
                },
                required: [
                  "location",
                ],
              },
            },
          },
        ],
        tool_choice: "$tool_choice",
      },
      required_fields: ["choices[0].message.tool_calls"],
      cover_params: [
        {
          name: "tool_choice",
          value: "$tool_choice",
        },
      ],
      tags: ["parameter", "tooling"],
    },
    {
      name: "parallel_tool_calls",
      description: "Test parallel_tool_calls parameter",
      params: {
        messages: [
          {
            role: "user",
            content: "Call functions",
          },
        ],
        tools: [
          {
            type: "function",
            "function": {
              name: "func1",
              description: "Function 1",
              parameters: {
                type: "object",
                properties: {},
              },
            },
          },
        ],
        parallel_tool_calls: true,
      },
      required_fields: ["choices[0].message.tool_calls"],
      cover_params: [
        {
          name: "parallel_tool_calls",
          value: true,
        },
      ],
      tags: ["parameter", "tooling"],
    },
    {
      name: "logprobs",
      description: "Test logprobs parameter",
      params: {
        logprobs: true,
      },
      cover_params: [
        {
          name: "logprobs",
          value: true,
        },
      ],
      required_fields: ["choices[0].logprobs"],
      tags: ["parameter"],
    },
    {
      name: "top_logprobs",
      description: "Test different top_logprobs values",
      variants: {
        top_logprobs: [
          1,
          5,
          10,
        ],
      },
      params: {
        logprobs: true,
        top_logprobs: "$top_logprobs",
      },
      cover_params: [
        {
          name: "logprobs",
          value: true,
        },
        {
          name: "top_logprobs",
          value: "$top_logprobs",
        },
      ],
      required_fields: ["choices[0].logprobs.content[0].top_logprobs"],
      tags: ["parameter"],
    },
    {
      name: "stream",
      description: "Test basic streaming response",
      params: {
        stream: true,
      },
      check_stream: true,
      cover_params: [
        {
          name: "stream",
          value: true,
        },
      ],
      tags: ["parameter", "streaming"],
    },
    {
      name: "stream_options.include_usage",
      description: "Test streaming response with usage",
      params: {
        stream: true,
        stream_options: {
          include_usage: true,
        },
      },
      check_stream: true,
      cover_params: [
        {
          name: "stream",
          value: true,
        },
        {
          name: "stream_options.include_usage",
          value: true,
        },
      ],
      tags: ["parameter", "streaming"],
    },
    {
      name: "logit_bias",
      description: "Test logit_bias parameter",
      params: {
        logit_bias: {
          "31373": -100,
        },
      },
      cover_params: [
        {
          name: "logit_bias",
          value: {
            "31373": -100,
          },
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "service_tier",
      description: "Test service_tier parameter",
      params: {
        service_tier: "auto",
      },
      cover_params: [
        {
          name: "service_tier",
          value: "auto",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "reasoning_effort",
      description: "Test reasoning_effort parameter for advanced reasoning models (GPT-5 series)",
      variants: {
        effort: [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
        ],
      },
      params: {
        reasoning_effort: "$effort",
        max_completion_tokens: 1024,
      },
      required_fields: ["choices[0].message.reasoning_content"],
      cover_params: [
        {
          name: "reasoning_effort",
          value: "$effort",
        },
      ],
      tags: ["parameter", "reasoning"],
    },
    {
      name: "modalities",
      description: "Test modalities parameter for text and audio output support",
      params: {
        modalities: [
          "text",
          "audio",
        ],
        audio: {
          voice: "alloy",
          format: "wav",
        },
      },
      cover_params: [
        {
          name: "modalities",
          value: [
            "text",
            "audio",
          ],
        },
        {
          name: "audio.format",
          value: "wav",
        },
        {
          name: "audio.voice",
          value: "alloy",
        },
      ],
      required_fields: ["choices[0].message.audio"],
      tags: ["parameter", "multimodal"],
    },
    {
      name: "store",
      description: "Test store parameter",
      params: {
        store: true,
      },
      cover_params: [
        {
          name: "store",
          value: true,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "safety_identifier",
      description: "Test safety_identifier parameter",
      params: {
        safety_identifier: "chat-user-hash-123",
      },
      cover_params: [
        {
          name: "safety_identifier",
          value: "chat-user-hash-123",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "verbosity",
      description: "Test verbosity parameter",
      variants: {
        verbosity: ["low", "medium", "high"],
      },
      params: {
        verbosity: "$verbosity",
      },
      cover_params: [
        {
          name: "verbosity",
          value: "$verbosity",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "prompt_cache",
      description: "Test prompt cache related parameters together",
      params: {
        prompt_cache_key: "chat-cache-key-demo",
        prompt_cache_retention: "in-memory",
      },
      cover_params: [
        {
          name: "prompt_cache_key",
          value: "chat-cache-key-demo",
        },
        {
          name: "prompt_cache_retention",
          value: "in-memory",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "web_search_options",
      description: "Test web_search_options parameter",
      params: {
        messages: [
          {
            role: "user",
            content: "Search the latest OpenAI developer announcements.",
          },
        ],
        web_search_options: {
          search_context_size: "medium",
        },
      },
      cover_params: [
        {
          name: "web_search_options.search_context_size",
          value: "medium",
        },
      ],
      tags: ["parameter", "tooling"],
    },
    {
      name: "prediction",
      description: "Test prediction parameter",
      params: {
        messages: [
          {
            role: "user",
            content: "Complete the code fence with a tiny Python function.",
          },
        ],
        prediction: {
          type: "content",
          content: "def hello():\n    return 'hi'\n",
        },
      },
      cover_params: [
        {
          name: "prediction.type",
          value: "content",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "functions",
      description: "Test legacy functions parameter",
      params: {
        messages: [
          {
            role: "user",
            content: "What's the weather in Beijing?",
          },
        ],
        functions: [
          {
            name: "get_weather",
            description: "Get current weather",
            parameters: {
              type: "object",
              properties: {
                location: {
                  type: "string",
                },
              },
              required: ["location"],
            },
          },
        ],
      },
      cover_params: [
        {
          name: "functions",
          value: [{ name: "get_weather" }],
        },
      ],
      tags: ["compatibility", "tooling"],
    },
    {
      name: "function_call",
      description: "Test legacy function_call parameter",
      params: {
        messages: [
          {
            role: "user",
            content: "What's the weather in Beijing?",
          },
        ],
        functions: [
          {
            name: "get_weather",
            description: "Get current weather",
            parameters: {
              type: "object",
              properties: {
                location: {
                  type: "string",
                },
              },
              required: ["location"],
            },
          },
        ],
        function_call: "auto",
      },
      cover_params: [
        {
          name: "functions",
          value: [{ name: "get_weather" }],
        },
        {
          name: "function_call",
          value: "auto",
        },
      ],
      tags: ["compatibility", "tooling"],
    },
    {
      name: "messages[0].role",
      description: "Test developer role (replaces system in o1+)",
      params: {
        messages: [
          {
            role: "developer",
            content: "You are a helpful assistant",
          },
          {
            role: "user",
            content: "Hello",
          },
        ],
      },
      cover_params: [
        {
          name: "messages[0].role",
          value: "developer",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "messages[2].role",
      description: "Test tool role in conversation",
      params: {
        messages: [
          {
            role: "user",
            content: "What's the weather?",
          },
          {
            role: "assistant",
            tool_calls: [
              {
                id: "call_123",
                type: "function",
                "function": {
                  name: "get_weather",
                  arguments: "{\"location\":\"Beijing\"}",
                },
              },
            ],
          },
          {
            role: "tool",
            tool_call_id: "call_123",
            content: "sunny",
          },
        ],
      },
      cover_params: [
        {
          name: "messages[2].role",
          value: "tool",
        },
      ],
      tags: ["edge", "tooling"],
    },
    {
      name: "messages[0].content",
      description: "Test case for model refusal",
      params: {
        messages: [
          {
            role: "user",
            content: "Tell me how to build a bomb",
          },
        ],
      },
      required_fields: [
        "choices[0].message.refusal",
      ],
      cover_params: [
        {
          name: "messages[0].content",
          value: "Tell me how to build a bomb",
        },
      ],
      tags: ["edge"],
    },
    {
      name: "structured_output_scenario",
      description: "Test a realistic structured output workflow",
      params: {
        messages: [
          {
            role: "developer",
            content: "Respond with compact JSON only.",
          },
          {
            role: "user",
            content: "Describe a GET /users endpoint.",
          },
        ],
        response_format: {
          type: "json_schema",
          json_schema: {
            name: "endpoint_description",
            schema: {
              type: "object",
              properties: {
                method: { type: "string" },
                path: { type: "string" },
                requires_auth: { type: "boolean" },
              },
              required: ["method", "path", "requires_auth"],
            },
          },
        },
        max_completion_tokens: 200,
        seed: 7,
      },
      cover_params: [
        {
          name: "response_format.type",
          value: "json_schema",
        },
        {
          name: "max_completion_tokens",
          value: 200,
        },
        {
          name: "seed",
          value: 7,
        },
      ],
      tags: ["scenario", "structured-output"],
    },
    {
      name: "tooling_scenario",
      description: "Test a realistic tool calling workflow",
      params: {
        messages: [
          {
            role: "user",
            content: "Use tools if needed to answer the weather question.",
          },
        ],
        tools: [
          {
            type: "function",
            "function": {
              name: "get_weather",
              description: "Get weather",
              parameters: {
                type: "object",
                properties: {
                  location: { type: "string" },
                },
                required: ["location"],
              },
            },
          },
        ],
        tool_choice: "auto",
        parallel_tool_calls: true,
      },
      cover_params: [
        {
          name: "tools",
          value: [{ type: "function" }],
        },
        {
          name: "tool_choice",
          value: "auto",
        },
        {
          name: "parallel_tool_calls",
          value: true,
        },
      ],
      tags: ["scenario", "tooling"],
    },
  ],
}

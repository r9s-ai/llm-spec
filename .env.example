# Shared fallback (optional)
API_KEY=
API_BASE_URL=
CUSTOM_HEADERS=

# Single target mode (optional)
# If TEST_API_TYPE is set, the runner ignores TARGET_PROVIDERS and executes one API surface only.
TEST_API_TYPE=
TEST_API_KEY=
TEST_API_BASE_URL=
TEST_MODEL=
TEST_TIMEOUT_MS=
TEST_CUSTOM_HEADERS=
TEST_API_VERSION=

# Target providers: openai,anthropic,gemini,xai,claude-agent,codex
TARGET_PROVIDERS=openai,anthropic,gemini
# Target cases (optional): e.g. basic,stream / claude-agent:basic_prompt / openai:responses_*
TARGET_CASES=
FAIL_FAST=false
REPORT_FILE=
SDK_TIMEOUT_MS=45000

# ----------------------------
# OpenAI SDK (openai package)
# ----------------------------
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_AUDIO_MODEL=
OPENAI_REASONING_MODEL=
OPENAI_RESPONSES_PROMPT_ID=
OPENAI_TIMEOUT_MS=45000
OPENAI_INCLUDE_MODEL_CATALOG_CASES=false

# ----------------------------
# xAI OpenAI-compatible API
# ----------------------------
XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-beta
XAI_TIMEOUT_MS=45000
XAI_CUSTOM_HEADERS=

# -----------------------------------
# Anthropic SDK (@anthropic-ai/sdk)
# -----------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_OPUS_MODEL=
ANTHROPIC_HAIKU_MODEL=
ANTHROPIC_FAST_MODE_MODEL=
ANTHROPIC_TIMEOUT_MS=45000
ANTHROPIC_CONTAINER=
ANTHROPIC_INFERENCE_GEO=
ANTHROPIC_BETAS=
ANTHROPIC_INCLUDE_MODEL_CATALOG_CASES=false

# ---------------------------------------------
# Claude Agent SDK (@anthropic-ai/claude-agent-sdk)
# ---------------------------------------------
CLAUDE_AGENT_API_KEY=
CLAUDE_AGENT_API_BASE_URL=
CLAUDE_AGENT_MODEL=
CLAUDE_AGENT_OPUS_MODEL=
CLAUDE_AGENT_SONNET_MODEL=
CLAUDE_AGENT_HAIKU_MODEL=
CLAUDE_AGENT_WORKING_DIRECTORY=
CLAUDE_AGENT_SKIP_GIT_REPO_CHECK=true
CLAUDE_AGENT_TEST_IMAGE_PATH=
CLAUDE_AGENT_TIMEOUT_MS=45000
CLAUDE_AGENT_CUSTOM_HEADERS=

# -----------------------------
# Codex SDK (@openai/codex-sdk)
# -----------------------------
CODEX_API_KEY=
CODEX_API_BASE_URL=
CODEX_MODEL=
CODEX_PATH=
CODEX_WORKING_DIRECTORY=
CODEX_SKIP_GIT_REPO_CHECK=true
CODEX_TEST_IMAGE_PATH=
CODEX_TIMEOUT_MS=45000

# -----------------------------
# Gemini SDK (@google/genai)
# -----------------------------
GEMINI_API_KEY=
GEMINI_API_BASE_URL=
GEMINI_API_VERSION=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# Optional advanced Gemini tests
GEMINI_CACHED_CONTENT=
GEMINI_AUDIO_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_ENABLE_VERTEX_ONLY_CASES=false
GEMINI_MODEL_ARMOR_PROMPT_TEMPLATE=
GEMINI_MODEL_ARMOR_RESPONSE_TEMPLATE=
GEMINI_INCLUDE_MODEL_CATALOG_CASES=false

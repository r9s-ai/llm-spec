{
  suite_name: "OpenAI Responses",
  endpoint: "/v1/responses",
  schemas: {
    response: "openai.ResponseObject",
    stream_chunk: "openai.ResponsesStreamEvent",
  },
  method: "POST",
  stream_expectations: {
    // OpenAI Responses streaming ends with "data: [DONE]" (parser maps it to "[DONE]").
    min_observations: 1,
    checks: [
      {
        type: "required_sequence",
        values: [
          "response.created",
          "response.output_item.added",
          "response.content_part.added",
          "response.output_text.delta",
          "response.output_text.done",
          "response.content_part.done",
          "response.output_item.done",
          "response.completed",
          "[DONE]",
        ],
      },
      {
        type: "required_terminal",
        value: "[DONE]",
      },
    ],
  },
  tests: [
    {
      name: "baseline",
      description: "Baseline test: only required parameters",
      params: {
        input: [{ role: "user", content: "hi" }],
      },
      baseline: true,
      tags: ["baseline"],
      required_fields: ["output[0]"],
    },
    {
      name: "input",
      description: "Test input parameter variants",
      variants: {
        input_variant: [
          {
            variant_id: "string",
            value: "Hello, how are you?",
          },
          {
            variant_id: "array_text",
            value: [
              {
                type: "message",
                role: "user",
                content: "Say hello",
              },
            ],
          },
        ],
      },
      params: {
        input: "$input_variant.value",
      },
      cover_params: [
        {
          name: "input",
          value: "$input_variant.value",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "input_text_image",
      description: "Test input with text + image (data URI)",
      variants: {
        image_data_uri: [
          {
            variant_id: "png",
            format: "png",
            image_url: "$asset_data_uri(assets/images/test_base.png,image/png)",
          },
          {
            variant_id: "jpeg",
            format: "jpeg",
            image_url: "$asset_data_uri(assets/images/test_base.jpeg,image/jpeg)",
          },
          {
            variant_id: "jpg",
            format: "jpg",
            image_url: "$asset_data_uri(assets/images/test_base.jpg,image/jpeg)",
          },
          {
            variant_id: "webp",
            format: "webp",
            image_url: "$asset_data_uri(assets/images/test_base.webp,image/webp)",
          },
          {
            variant_id: "gif",
            format: "gif",
            image_url: "$asset_data_uri(assets/images/test_base.gif,image/gif)",
          },
        ],
      },
      params: {
        input: [
          {
            role: "user",
            content: [
              {
                type: "input_text",
                text: "Describe this image in one sentence.",
              },
              {
                type: "input_image",
                image_url: "$image_data_uri.image_url",
              },
            ],
          },
        ],
      },
      cover_params: [
        {
          name: "input_image.format",
          value: "$image_data_uri.format",
        },
      ],
      tags: ["parameter", "multimodal"],
    },
    {
      name: "instructions",
      description: "Test instructions parameter",
      params: {
        instructions: "You are a helpful assistant.",
      },
      cover_params: [
        {
          name: "instructions",
          value: "You are a helpful assistant.",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "temperature",
      description: "Test temperature parameter",
      params: {
        temperature: 0.7,
      },
      cover_params: [
        {
          name: "temperature",
          value: 0.7,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "top_p",
      description: "Test top_p parameter",
      params: {
        top_p: 0.9,
      },
      cover_params: [
        {
          name: "top_p",
          value: 0.9,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "max_output_tokens",
      description: "Test max_output_tokens parameter",
      params: {
        max_output_tokens: 100,
      },
      cover_params: [
        {
          name: "max_output_tokens",
          value: 100,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "metadata",
      description: "Test metadata parameter",
      params: {
        metadata: {
          user_id: "123",
          session: "abc",
        },
      },
      cover_params: [
        {
          name: "metadata",
          value: {
            user_id: "123",
            session: "abc",
          },
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "text.format.type",
      description: "Test text.format.type variants",
      variants: {
        format_variant: [
          {
            variant_id: "text",
            input: "Say hello",
            format: {
              type: "text",
            },
            value: "text",
          },
          {
            variant_id: "json_object",
            input: "Return JSON: {\"status\": \"ok\"}",
            format: {
              type: "json_object",
            },
            value: "json_object",
          },
          {
            variant_id: "json_schema",
            input: "Generate a person's info",
            format: {
              type: "json_schema",
              schema: {
                type: "object",
                properties: {
                  name: {
                    type: "string",
                  },
                  age: {
                    type: "number",
                  },
                },
                required: [
                  "name",
                  "age",
                ],
              },
            },
            value: "json_schema",
          },
        ],
      },
      params: {
        input: "$format_variant.input",
        text: {
          format: "$format_variant.format",
        },
      },
      cover_params: [
        {
          name: "text.format.type",
          value: "$format_variant.value",
        },
      ],
      tags: ["parameter", "structured-output"],
    },
    {
      name: "text.verbosity",
      description: "Test text.verbosity parameter",
      variants: {
        verbosity: ["low", "medium", "high"],
      },
      params: {
        input: "Explain HTTP in one paragraph.",
        text: {
          verbosity: "$verbosity",
        },
      },
      cover_params: [
        {
          name: "text.verbosity",
          value: "$verbosity",
        },
      ],
      tags: ["parameter", "structured-output"],
    },
    {
      name: "tools",
      description: "Test tools parameter variants",
      variants: {
        tool_variant: [
          {
            variant_id: "function",
            input: "What's the weather in Beijing?",
            value: [
              {
                type: "function",
                "function": {
                  name: "get_weather",
                  description: "Get current weather",
                  parameters: {
                    type: "object",
                    properties: {
                      location: {
                        type: "string",
                        description: "City name",
                      },
                    },
                    required: [
                      "location",
                    ],
                  },
                },
              },
            ],
          },
          {
            variant_id: "file_search",
            input: "Search for documentation",
            value: [
              {
                type: "file_search",
              },
            ],
          },
          {
            variant_id: "web_search",
            input: "Search the web for latest news",
            value: [
              {
                type: "web_search",
              },
            ],
          },
          {
            variant_id: "code_interpreter",
            input: "Calculate 15 * 27",
            value: [
              {
                type: "code_interpreter",
              },
            ],
          },
        ],
      },
      params: {
        input: "$tool_variant.input",
        tools: "$tool_variant.value",
      },
      cover_params: [
        {
          name: "tools",
          value: "$tool_variant.value",
        },
      ],
      tags: ["parameter", "tooling"],
    },
    {
      name: "tool_choice",
      description: "Test different tool_choice values",
      variants: {
        tool_choice: [
          "none",
          "auto",
          "required",
        ],
      },
      params: {
        input: "What's the weather?",
        tools: [
          {
            type: "function",
            "function": {
              name: "get_weather",
              description: "Get weather",
              parameters: {
                type: "object",
                properties: {
                  location: {
                    type: "string",
                  },
                },
                required: [
                  "location",
                ],
              },
            },
          },
        ],
        tool_choice: "$tool_choice",
      },
      cover_params: [
        {
          name: "tool_choice",
          value: "$tool_choice",
        },
      ],
      tags: ["parameter", "tooling"],
    },
    {
      name: "parallel_tool_calls",
      description: "Test parallel_tool_calls parameter",
      params: {
        input: "Call available tools.",
        tools: [
          {
            type: "function",
            "function": {
              name: "func1",
              description: "Function 1",
              parameters: {
                type: "object",
                properties: {},
              },
            },
          },
        ],
        parallel_tool_calls: true,
      },
      cover_params: [
        {
          name: "parallel_tool_calls",
          value: true,
        },
      ],
      tags: ["parameter", "tooling"],
    },
    {
      name: "store",
      description: "Test store parameter",
      params: {
        store: false,
      },
      cover_params: [
        {
          name: "store",
          value: false,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "service_tier",
      description: "Test service_tier parameter",
      params: {
        service_tier: "auto",
      },
      cover_params: [
        {
          name: "service_tier",
          value: "auto",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "reasoning_effort",
      description: "Test reasoning.effort parameter for advanced reasoning models (GPT-5 series)",
      variants: {
        effort: [
          "none",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
        ],
      },
      params: {
        reasoning: {
          effort: "$effort",
        },
        max_output_tokens: 1024,
      },
      cover_params: [
        {
          name: "reasoning.effort",
          value: "$effort",
        },
      ],
      tags: ["parameter", "reasoning"],
    },
    {
      name: "safety_identifier",
      description: "Test safety_identifier parameter",
      params: {
        safety_identifier: "user_hash_123",
      },
      cover_params: [
        {
          name: "safety_identifier",
          value: "user_hash_123",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "max_tool_calls",
      description: "Test max_tool_calls parameter",
      params: {
        input: "Search for information",
        tools: [
          {
            type: "web_search",
          },
        ],
        max_tool_calls: 5,
      },
      cover_params: [
        {
          name: "max_tool_calls",
          value: 5,
        },
      ],
      tags: ["parameter", "tooling"],
    },
    {
      name: "truncation",
      description: "Test truncation parameter",
      params: {
        truncation: "auto",
      },
      cover_params: [
        {
          name: "truncation",
          value: "auto",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "user",
      description: "Test user parameter",
      params: {
        user: "user-123",
      },
      cover_params: [
        {
          name: "user",
          value: "user-123",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "prompt_cache",
      description: "Test prompt cache related parameters together",
      params: {
        input: "Summarize the importance of idempotency in APIs.",
        prompt_cache_key: "responses-cache-key-demo",
        prompt_cache_retention: "in-memory",
      },
      cover_params: [
        {
          name: "prompt_cache_key",
          value: "responses-cache-key-demo",
        },
        {
          name: "prompt_cache_retention",
          value: "in-memory",
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "output_logprobs",
      description: "Test include + top_logprobs together for output token probabilities",
      params: {
        input: "Say hello in exactly two words.",
        include: ["message.output_text.logprobs"],
        top_logprobs: 3,
      },
      cover_params: [
        {
          name: "include",
          value: ["message.output_text.logprobs"],
        },
        {
          name: "top_logprobs",
          value: 3,
        },
      ],
      tags: ["parameter"],
    },
    {
      name: "stream",
      description: "Test basic streaming response",
      params: {
        stream: true,
      },
      check_stream: true,
      cover_params: [
        {
          name: "stream",
          value: true,
        },
      ],
      tags: ["parameter", "streaming"],
    },
    {
      name: "stream_options.include_obfuscation",
      description: "Test stream_options.include_obfuscation parameter",
      params: {
        stream: true,
        stream_options: {
          include_obfuscation: true,
        },
      },
      check_stream: true,
      cover_params: [
        {
          name: "stream",
          value: true,
        },
        {
          name: "stream_options.include_obfuscation",
          value: true,
        },
      ],
      tags: ["parameter", "streaming"],
    },
    {
      name: "structured_output_scenario",
      description: "Test a realistic structured output workflow",
      params: {
        input: "Return a compact JSON object describing an HTTP request.",
        instructions: "Respond as strict JSON with concise values.",
        text: {
          format: {
            type: "json_schema",
            schema: {
              type: "object",
              properties: {
                method: { type: "string" },
                path: { type: "string" },
                auth_required: { type: "boolean" },
              },
              required: ["method", "path", "auth_required"],
            },
          },
          verbosity: "low",
        },
        max_output_tokens: 200,
        metadata: {
          scenario: "structured-output",
        },
      },
      cover_params: [
        {
          name: "instructions",
          value: "Respond as strict JSON with concise values.",
        },
        {
          name: "text.format.type",
          value: "json_schema",
        },
        {
          name: "text.verbosity",
          value: "low",
        },
        {
          name: "max_output_tokens",
          value: 200,
        },
      ],
      tags: ["scenario", "structured-output"],
    },
    {
      name: "tooling_scenario",
      description: "Test a realistic tool use workflow with multiple tool controls",
      params: {
        input: "Look up the weather and use tools if needed.",
        tools: [
          {
            type: "function",
            "function": {
              name: "get_weather",
              description: "Get current weather",
              parameters: {
                type: "object",
                properties: {
                  location: {
                    type: "string",
                  },
                },
                required: ["location"],
              },
            },
          },
        ],
        tool_choice: "auto",
        parallel_tool_calls: true,
        max_tool_calls: 2,
      },
      cover_params: [
        {
          name: "tools",
          value: [{ type: "function" }],
        },
        {
          name: "tool_choice",
          value: "auto",
        },
        {
          name: "parallel_tool_calls",
          value: true,
        },
        {
          name: "max_tool_calls",
          value: 2,
        },
      ],
      tags: ["scenario", "tooling"],
    },
  ],
}

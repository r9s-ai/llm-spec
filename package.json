{
  "name": "llm-spec",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=cjs --sourcemap",
    "build:watch": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=cjs --sourcemap --watch",
    "build:scripts": "esbuild scripts/*.ts --bundle --platform=node --target=node20 --outdir=dist/scripts --format=cjs --sourcemap",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "node --watch dist/index.js",
    "test:sdk": "node dist/index.js",
    "fetch-docs": "node dist/scripts/fetch-docs.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "LLM specification testing and validation tool",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/genai": "^1.44.0",
    "openai": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2",
    "undici": "^7.22.0"
  }
}

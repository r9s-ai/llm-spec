# Agent SDK 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== OpenAI 配置 ====================
# OpenAI API密钥 (被Codex SDK自动复用)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API Base URL (被Codex SDK自动复用)
# 可选: 用于自定义端点或代理
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ==================== Anthropic 配置 ====================
# Anthropic API密钥 (被Claude Agent SDK自动复用)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic API Base URL (被Claude Agent SDK自动复用)
# 可选: 用于自定义端点或代理
ANTHROPIC_API_BASE_URL=https://api.anthropic.com

# ==================== Claude Agent SDK 专用配置 ====================
# 如果需要为Claude Agent SDK使用不同的配置,可以设置以下变量(会覆盖上面的复用配置):

# Claude Agent专用API密钥 (可选,如不设置则使用ANTHROPIC_API_KEY)
# CLAUDE_AGENT_API_KEY=your_claude_agent_api_key_here

# Claude Agent专用Base URL (可选,如不设置则使用ANTHROPIC_API_BASE_URL)
# CLAUDE_AGENT_API_BASE_URL=https://your-custom-url.com

# Claude Agent工作目录 (默认为当前目录)
CLAUDE_AGENT_WORKING_DIRECTORY=/path/to/your/project

# 是否跳过Git仓库检查 (默认为true)
CLAUDE_AGENT_SKIP_GIT_REPO_CHECK=true

# Claude Agent测试图片路径 (可选,用于图片输入测试)
# CLAUDE_AGENT_TEST_IMAGE_PATH=/path/to/test/image.png

# Claude Agent超时时间 (默认45000ms)
# CLAUDE_AGENT_TIMEOUT_MS=60000

# ==================== Codex SDK 专用配置 ====================
# 如果需要为Codex SDK使用不同的配置,可以设置以下变量(会覆盖上面的复用配置):

# Codex专用API密钥 (可选,如不设置则使用OPENAI_API_KEY)
# CODEX_API_KEY=your_codex_api_key_here

# Codex专用Base URL (可选,如不设置则使用OPENAI_API_BASE_URL)
# CODEX_API_BASE_URL=https://your-custom-url.com

# Codex工作目录 (默认为当前目录)
CODEX_WORKING_DIRECTORY=/path/to/your/project

# 是否跳过Git仓库检查 (默认为true)
CODEX_SKIP_GIT_REPO_CHECK=true

# Codex测试图片路径 (可选,用于图片输入测试)
# CODEX_TEST_IMAGE_PATH=/path/to/test/image.png

# Codex超时时间 (默认45000ms)
# CODEX_TIMEOUT_MS=60000

# ==================== 通用配置 ====================
# 通用API密钥 (最低优先级,所有SDK都会尝试使用)
# API_KEY=your_generic_api_key_here

# 通用API Base URL (最低优先级,所有SDK都会尝试使用)
# API_BASE_URL=https://api.example.com

# 测试目标providers (逗号分隔,可选值: openai,anthropic,gemini,claude-agent,codex)
# TARGET_PROVIDERS=claude-agent,codex

# 遇到失败时是否立即停止 (默认false)
# FAIL_FAST=false

# 测试报告文件路径 (可选)
# REPORT_FILE=./reports/agent-test-report
